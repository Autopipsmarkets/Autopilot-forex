# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Public URL of the deployed service (no trailing slash). Railway gives you one;
# you can also use a custom domain later.
APP_URL=https://your-service.up.railway.app

# ─── Database (Railway Postgres plugin injects DATABASE_URL) ────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autopilot?schema=public

# ─── Auth ───────────────────────────────────────────────────────────────
# 64+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Comma separated. Leave empty in production to allow same-origin only.
CORS_ORIGINS=

# ─── Bootstrap admin (used once by `npm run db:seed`) ───────────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-before-you-run-seed
ADMIN_NAME=Abigael Taran

# ─── Email (Resend). Optional but required for verification + resets ────
RESEND_API_KEY=
MAIL_FROM=Autopilot Forex <no-reply@yourdomain.com>

# ─── Payments: Stripe (cards / international) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard; the seed script also stores them
# on plans when provided.
STRIPE_PRICE_VIP_MONTHLY=

# ─── Payments: M-Pesa (Kenya) via IntaSend ──────────────────────────────
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
INTASEND_SANDBOX=true

# ─── Market data (Twelve Data free tier) ────────────────────────────────
TWELVE_DATA_API_KEY=
